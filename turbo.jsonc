// Turborepo task graph for this workspace (design D7 in
// openspec/changes/archive/2026-10-17-bootstrap-monorepo/design.md).
{
  "$schema": "https://turborepo.com/schema.json",

  "tasks": {
    // Build a member after all of its workspace dependencies (^build) have built.
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".svelte-kit/cloudflare/**", ".svelte-kit/output/**"],
    },

    // Type-check a member after its workspace dependencies have been checked.
    "check": {
      "dependsOn": ["^check"],
    },

    // Lint a member after its workspace dependencies have been linted.
    "lint": {
      "dependsOn": ["^lint"],
    },

    // Unit tests run against built workspace dependencies, so they exercise
    // the artifacts other members actually consume. No outputs: coverage is
    // not collected yet, and an empty list keeps Turborepo from warning that
    // declared coverage files are missing.
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
    },

    // End-to-end tests start a real server, so they are never cached. The
    // Hyperdrive local connection string reaches `wrangler dev` so `admin`
    // can reach the local database (design D5, D6), and `DATABASE_URL` lets
    // the admin e2e seed entries before it drives the published snapshots
    // (design D7 in openspec/changes/revisions-publishing/design.md).
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"],
      "passThroughEnv": [
        "CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE",
        "DATABASE_URL",
      ],
    },

    // Database integration tests change the database named by
    // `DATABASE_URL_TEST`, so they are never cached and that variable reaches
    // the task (design D6).
    "test:integration": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL_TEST"],
    },

    // Dev servers run until stopped, so they are persistent and never cached.
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE",
      ],
    },

    // Repository-wide `lint` and `format` run directly from the root scripts
    // rather than through this task graph.
  },

  // Anything that changes these files invalidates every task's cache
  // (the Prettier config is not part of any member's package).
  "globalDependencies": [".prettierrc.yaml", ".prettierignore"],
}
