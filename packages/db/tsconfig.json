{
  // A source-only TypeScript package like @ycmcuenca/edge (design D1): the
  // consuming app bundles it through Vite, so it is checked here but never
  // emitted on its own. `lib: esnext` alone plus Node types, so the migration
  // scripts (Bun, over `pg`) and the app code both type-check.
  "extends": "@ycmcuenca/tsconfig/base.json",
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // Relative imports carry their extension so Node's ESM loader (which the
    // apps' Vite configs use) can resolve this package's source (design D1).
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src",
    "scripts",
    "drizzle.config.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts"
  ]
}
