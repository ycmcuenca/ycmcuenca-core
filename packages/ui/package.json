    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@ycmcuenca/eslint-config": "workspace:*",
    "@ycmcuenca/tsconfig": "workspace:*",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3"
  }
