# Local development environment (design D6 in
# openspec/changes/content-store/design.md). Copy this file to `.env` and
# replace every placeholder with a local value; `.env` is git-ignored and must
# never be committed (the repository is public).
#
#   cp .env.example .env
#
# `POSTGRES_PASSWORD` is read by `compose.yaml`; the connection strings point
# at the same container (`127.0.0.1:54329`). `DATABASE_URL` is the migrator
# (the container's `postgres` superuser); `DATABASE_URL_TEST` is the same user
# on the integration-test database; `RUNTIME_ROLE_PASSWORD` seeds the
# `cms_runtime` login locally, and the Hyperdrive variable is how `wrangler
# dev` connects `admin` to that role without a binding in the file.

POSTGRES_PASSWORD=change-me-local-postgres
DATABASE_URL=postgres://postgres:change-me-local-postgres@127.0.0.1:54329/cms
DATABASE_URL_TEST=postgres://postgres:change-me-local-postgres@127.0.0.1:54329/cms_test
RUNTIME_ROLE_PASSWORD=change-me-runtime-role-password-60-bits
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://cms_runtime:change-me-runtime-role-password-60-bits@127.0.0.1:54329/cms
