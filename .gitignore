# Dependencies (installed, never committed)
node_modules/

# Build output (generated by SvelteKit, Turborepo and Wrangler)
.svelte-kit/
.wrangler/
.turbo/
build/
dist/

# Test output (generated by Vitest and Playwright)
coverage/
playwright-report/
test-results/

# Local secrets and environment files (public repo: these must never be committed)
.dev.vars*
.env
.env.*
!.env.example
# Throwaway Access key pair written by the admin e2e fixture (test material,
# but still key material: never committed)
.access-fixture/

# Editor and OS noise
.DS_Store
*.log

# Vite metadata (written by the dev server next to vite.config.*)
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Local tooling state (code indexes and similar; machine-specific, never committed)
.codegraph/
