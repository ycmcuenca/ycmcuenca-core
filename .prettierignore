# Generated build output (never hand-edited, never formatted)
.svelte-kit/
.wrangler/
.turbo/
build/
dist/

# Test output
coverage/
playwright-report/
test-results/

# Generated by `wrangler types`; regenerating it is the way to change it.
worker-configuration.d.ts

# The lockfile is generated by Bun; formatting it would fight the package
# manager on every install.
bun.lock

# Agent files generated by the OpenSpec CLI: they are regenerated on updates
# and are not hand-edited, so they are not formatted here.
.claude/
.opencode/

# Archived OpenSpec changes are historical records; reformatting them would
# make the history and its diffs harder to trust.
openspec/changes/archive/

# Release changelogs are generated by release-please on every release, in the
# tool's own Markdown style. Prettier must not fight that generator: it would
# reformat them on every release and fail the check on the release pull request.
CHANGELOG.md
