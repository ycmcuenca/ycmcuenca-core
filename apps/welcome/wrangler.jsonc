// Cloudflare Workers configuration for `welcome` (design D4 in
// openspec/changes/archive/2026-10-18-edge-infrastructure/design.md). The worker name is what
// serves welcome.ycmcuenca.workers.dev once deployed.
{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Becomes welcome.ycmcuenca.workers.dev at deploy time.
  "name": "welcome",

  // SvelteKit's Workers build: the entry script and the static assets
  // directory it serves (the ASSETS binding is created by the adapter).
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },

  // The date pins the runtime's behavior so it never changes under the app.
  "compatibility_date": "2026-10-17",
  // nodejs_als provides AsyncLocalStorage, which this ecosystem expects;
  // `nodejs_compat` waits until a library actually needs it (A5).
  "compatibility_flags": ["nodejs_als"],

  // Serve on welcome.ycmcuenca.workers.dev and give every version a preview
  // URL; there is no route or custom domain (D4, P4).
  "workers_dev": true,
  "preview_urls": true,

  // The published snapshots `welcome` reads (design D3 in
  // openspec/changes/public-rendering/design.md): the same namespace `admin`
  // writes, and the only content source on the read path. `welcome` has no
  // database binding, so a database outage cannot reach a visitor (C5). The
  // id is a public identifier, not a secret: it is useless without the
  // account's credentials.
  "kv_namespaces": [
    { "binding": "SNAPSHOTS", "id": "c18b4b7d16494320b81857cf96a4b715" },
  ],

  // The single source of absolute URLs (design D4): canonical links, the
  // sitemap and robots.txt all use this committed production origin, so a
  // preview URL never claims to be canonical.
  "vars": {
    "SITE_ORIGIN": "https://welcome.ycmcuenca.workers.dev",
  },

  // Workers Logs with invocation logs and traces at full sampling (D4, I9).
  // A 404 writes no application log line, so the Free plan's log volume stays
  // proportional to real traffic.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
}
