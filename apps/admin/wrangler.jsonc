// Cloudflare Workers configuration for `admin` (design D4 in
// openspec/changes/archive/2026-10-18-edge-infrastructure/design.md). The worker name is what
// serves admin.ycmcuenca.workers.dev once deployed.
{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Becomes admin.ycmcuenca.workers.dev at deploy time.
  "name": "admin",

  // SvelteKit's Workers build: the entry script and the static assets
  // directory it serves (the ASSETS binding is created by the adapter).
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },

  // The date pins the runtime's behavior so it never changes under the app.
  "compatibility_date": "2026-10-17",
  // nodejs_als provides AsyncLocalStorage, which this ecosystem expects;
  // `nodejs_compat` waits until a library actually needs it (A5).
  "compatibility_flags": ["nodejs_als"],

  // Serve on admin.ycmcuenca.workers.dev and give every version a preview
  // URL; there is no route or custom domain (D4, P4).
  "workers_dev": true,
  "preview_urls": true,

  // Workers Logs with invocation logs and traces at full sampling (D4, I9).
  // A refusal writes one warning line and a 404 no application line, so the
  // Free plan's log volume stays proportional to real traffic.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },

  // The committed production trust configuration for the in-worker Access
  // check (D4, D6). Both values are public identifiers, not secrets: the team
  // domain must be an https://<team>.cloudflareaccess.com origin (the unit
  // test and the deploy both enforce it), and the audience is the Access
  // application's tag, printed by `scripts/cloudflare/apply-access.sh`
  // (task 5.3).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://ycmcuenca.cloudflareaccess.com",
    "ACCESS_AUD": "00be52cc2f99c06cde34a5ea393d5e09a5b3cf9a54637b5ec6ec81a8e7709c88",
  },
}
